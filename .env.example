# AI Auto Poster Environment Variables Template
# Copy this file to '.env' and fill in the values.

# Core AI API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Image Sourcing & Generation
UNSPLASH_ACCESS_KEY=

# Video Sourcing & Generation
PEXELS_API_KEY=
HERA_API_KEY=
HIGGSFIELD_API_KEY=

# Audio & Speech
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_2=
ELEVENLABS_VOICE_ID=

# Facebook Graph API Credentials
FB_APP_ID=
FB_APP_SECRET=
FB_USER_ACCESS_TOKEN=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# YouTube API Credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Runner Control Variables
TREND_CATEGORY=
SHORTS_RENDER_MODE=pexels
ALLOW_STOCK_FALLBACK=true
